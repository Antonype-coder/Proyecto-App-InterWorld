{
    "name": "tiendaadmin/backend",
    "description": "API REST profesional para TiendaAdmin",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5",
        "ramsey/uuid": "^4.7",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "TiendaAdmin\\": "src/"
        },
        "files": [
            "utils/Helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}